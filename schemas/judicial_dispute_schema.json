{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DS01 - UMKM Legal Dispute Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "case_number", "court_name", "court_level",
    "decision_date", "publication_date", "dispute_category",
    "dispute_subcategory", "claimant_type", "defendant_type",
    "business_size", "business_sector", "province", "district",
    "claim_type", "judgment_outcome", "remedy_type",
    "appeal_status", "execution_status", "source_url",
    "retrieval_date", "document_hash", "extraction_confidence",
    "validation_status"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "case_number": {"type": "string", "minLength": 1},
    "court_name": {"type": "string", "minLength": 1},
    "court_level": {"type": "string", "enum": ["first_instance", "appellate", "cassation", "review", "commercial", "administrative", "unknown"]},
    "decision_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "publication_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "dispute_category": {"type": "string", "minLength": 1},
    "dispute_subcategory": {"type": "string"},
    "claimant_type": {"type": "string", "enum": ["individual", "micro_enterprise", "small_enterprise", "medium_enterprise", "large_enterprise", "financial_institution", "government", "platform", "unknown"]},
    "defendant_type": {"type": "string", "enum": ["individual", "micro_enterprise", "small_enterprise", "medium_enterprise", "large_enterprise", "financial_institution", "government", "platform", "unknown"]},
    "business_size": {"type": "string", "enum": ["micro", "small", "medium", "unknown"]},
    "business_sector": {"type": "string"},
    "province": {"type": "string"},
    "district": {"type": "string"},
    "claim_type": {"type": "string"},
    "judgment_outcome": {"type": "string"},
    "remedy_type": {"type": "string"},
    "appeal_status": {"type": "string"},
    "execution_status": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "retrieval_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "document_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "extraction_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "validation_status": {"type": "string", "enum": ["verified", "provisional", "synthetic", "rejected"]}
  }
}
